Script tags:
<script>
 setTimeout(function checkRender() {
    if (document.querySelector('.canopy-topic-section')?.offsetParent) {
      if (document.getElementById(123)?.offsetParent) {
        alert();
      }
    } else {
      setTimeout(checkRender, 0);
    }
  }, 0) // Wait until content has rendered and then check if this section is visible, to avoid running alert on every page.
 </script>
 <div id="123">ABC</div>

